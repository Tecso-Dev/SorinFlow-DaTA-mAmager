# Local-dev Dockerfile: Docker Hub is unreachable from this network (403),
# so build from the locally available Playwright image which already bundles
# Python + Chromium matching playwright==1.41.0 in requirements.txt.
FROM mcr.microsoft.com/playwright/python:v1.41.0-jammy

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.lock .

# requirements.lock pins numpy<2 itself (see requirements.txt), so no separate
# numpy pre-install step is needed before it.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --require-hashes -r requirements.lock

COPY . .

# Same non-root user as the production Dockerfile (see its comment) — local
# should catch a permission problem before production does, not the other
# way round. docker-compose.local.yml bind-mounts app/, frontend/,
# migrations/, scripts/, deploy/ and alembic.ini over parts of this, which
# keeps its host ownership either way; only /app/data and /app/logs, which
# stay inside the image's own layer, need the chown below.
RUN mkdir -p /app/data/images /app/data/cookies /app/logs && \
    chown -R pwuser:pwuser /app
USER pwuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
