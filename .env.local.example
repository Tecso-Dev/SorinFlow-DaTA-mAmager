# Local Docker dev stack (docker-compose.local.yml) — throwaway values only,
# never a real secret. Copy to .env.local (gitignored) and fill nothing in:
# these values already work out of the box.
#
#   cp .env.local.example .env.local
#   docker compose --env-file .env.local -f docker-compose.local.yml up -d --build

ENVIRONMENT=development
DEBUG=true

# Postgres — host port 5433 (5432 is a brew Postgres on this Mac). The name
# is deliberately not divar_scraper: that's the production/brew database name,
# and a typo'd DATABASE_URL pointing at the wrong port would otherwise still
# connect to something with real-looking data in it.
POSTGRES_USER=sorinflow
POSTGRES_PASSWORD=local-dev-only-pg
POSTGRES_DB=divar_scraper_local
DATABASE_URL=postgresql+asyncpg://sorinflow:local-dev-only-pg@db:5432/divar_scraper_local

# Redis — host port 6380 (6379 is brew redis)
REDIS_PASSWORD=local-dev-only-redis
REDIS_URL=redis://:local-dev-only-redis@redis:6379/0

# Host port for the backend. 8000 is the default; bump it if something else
# on this machine already holds it (docker compose port-conflict error says so).
BACKEND_PORT=8000

SECRET_KEY=local-dev-only-secret-key-do-not-use-in-prod
API_KEY=
METRICS_TOKEN=

# The two accounts app/database.py:init_db seeds automatically on first boot
# (_seed_super_admin, _seed_root) when the users table is empty.
SUPER_ADMIN_USERNAME=owner
SUPER_ADMIN_PASSWORD=local-pass-1234
ROOT_USERNAME=root
ROOT_PASSWORD=local-pass-1234
ROOT_EMAIL=root@local.test

# Saved scrapes fire themselves at their hour otherwise — off so a laptop
# left running doesn't start a real Divar scrape unattended.
SCRAPE_SCHEDULER=false

# Nothing on this box should talk to Divar by itself: the session verifier
# would probe divar.ir every 10 minutes with the seeded fake cookies, and
# the APK mirror would download Divar's app every 6 hours.
DIVAR_SESSION_CHECK_MINUTES=0
APK_MIRROR_HOURS=0

# Off by default already (no key set), left explicit: no Divar credentials,
# proxies, SMS provider or GCP project exist on this box.
PROXY_ENABLED=false
GCP_ENABLED=false
PUBLIC_AUTH_ENABLED=false

CORS_ORIGINS=*
SERVER_IP=127.0.0.1
DOMAIN=localhost

# cookies_path / images_path / downloads_path / logs_path are left at their
# app/config.py defaults (/app/data/..., /app/logs) — Dockerfile.local already
# creates those inside the image, so nothing to override here.
