# =================================
# SorinFlow Divar Scraper Configuration
# =================================

# Environment
ENVIRONMENT=production

# Server Configuration
SERVER_IP=171.22.182.91
DOMAIN=scc.sorinflow.com

# Database Configuration
POSTGRES_USER=sorinflow
POSTGRES_PASSWORD=  # openssl rand -hex 24
POSTGRES_DB=divar_scraper
DATABASE_URL=postgresql+asyncpg://sorinflow:<POSTGRES_PASSWORD>@db:5432/divar_scraper

# Redis Configuration
REDIS_PASSWORD=  # openssl rand -hex 24
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-with-random-string
API_KEY=change-this-to-a-strong-random-api-key

# Scraper Configuration
SCRAPER_HEADLESS=true
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5

# Proxy Configuration (Optional)
PROXY_ENABLED=false
PROXY_LIST=45.83.181.214:57623,146.19.143.69:11599

# Phone Number for Divar Login
DIVAR_PHONE_NUMBER=09058432452

# SMS — Kavenegar (https://kavenegar.com)
KAVENEGAR_API_KEY=
# Kavenegar template for login codes. Create it in their panel with
# %token as the placeholder; leave empty to send codes as plain SMS.
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=

# SMS — Melipayamak (https://melipayamak.com)
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=

# Timezone
TZ=Asia/Tehran

# ── Public portal (visitor sign-up) ───────────────────────────────────────────
# Ships OFF. While false, /portal redirects to the dashboard and every
# /api/public/auth/* endpoint answers 404 — the live panel is untouched.
# Turn this on only once an Iranian SMS panel is provisioned below, otherwise
# users register and never receive their code.
PUBLIC_AUTH_ENABLED=false

# Which provider carries the login/registration code:
#   kavenegar | melipayamak | console
# "console" writes the code to the application log instead of sending it, so the
# sign-up flow can be exercised before an SMS account exists. It refuses to work
# when ENVIRONMENT=production — a login code in a live server's log is a
# credential sitting in plain text.
AUTH_SMS_PROVIDER=kavenegar

# Verification code behaviour
AUTH_CODE_LENGTH=5
AUTH_CODE_TTL_SECONDS=180
AUTH_CODE_RESEND_COOLDOWN=90
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_MAX_SENDS_PER_HOUR=5
# Failed password attempts per identifier per 15 minutes before lockout
AUTH_LOGIN_MAX_ATTEMPTS=10

# ── Root account (the developer's own access) ─────────────────────────────────
# Seeded on boot and never creatable from the panel. Leave ROOT_PASSWORD empty
# to skip seeding entirely. Once the account exists this value is ignored, so
# putting it back cannot silently reset a rotated password.
ROOT_USERNAME=root
ROOT_PASSWORD=
ROOT_EMAIL=

# ── Google Cloud Observability ────────────────────────────────────────────────
# OFF by default. Google's endpoints are not reachable from an Iranian IP, so
# this is only useful behind a VPN, after a migration, or pointed at a client's
# project. Everything fails soft when it cannot connect: the exporter backs off
# and reports on /api/gcp/status, and no request or scrape ever waits on Google.
GCP_ENABLED=false
GCP_PROJECT_ID=
# The service-account JSON itself, or a path to it. Treat it as a secret —
# put it in the Kubernetes Secret, never in a tracked file. See SECRETS.md.
GCP_SERVICE_ACCOUNT_JSON=
GCP_LOG_NAME=sorinflow
# Optional: also publish log records to a Pub/Sub topic
GCP_PUBSUB_TOPIC=
# generic_node resource labels — this is self-hosted k3s, not GKE
GCP_LOCATION=ir-tehran
GCP_NAMESPACE=sorinflow
GCP_NODE_ID=backend
GCP_EXPORT_INTERVAL=60
GCP_BATCH_SIZE=200
GCP_TIMEOUT_SECONDS=10

# ── Metrics ───────────────────────────────────────────────────────────────────
# Guards /metrics with its own credential, so a monitoring scraper never needs
# the key that opens the rest of the API. Empty disables the endpoint (404).
METRICS_TOKEN=

# Email — Gmail needs an App Password, not the account password.
# May also be set from the ایمیل panel. See SECRETS.md §2c.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Kavenegar template for login codes sent by SMS (optional)

# ── LLM (optional) — the AI features: reasons beside matches today, the agents
# next. Any OpenAI-compatible endpoint; Liara's AI gateway is the one in use:
#   LLM_BASE_URL = https://ai.liara.ir/api/<project-id>/v1
#   LLM_MODEL    = provider/model as Liara names it, e.g. openai/gpt-4.1-mini
# Managed as GitHub Actions secrets: the deploy copies them into the cluster
# Secret (see SECRETS.md §2d). Empty = the AI features stay off, nothing breaks.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# The other jobs' models (plain settings, defaults in k8s/04-backend.yaml):
# reading listings and needs, looking at photos, embedding text. Candidates
# for the phase-1 bake-off: google/gemini-2.5-flash (reading), the Claude
# Haiku 4.5 id from the console (writing).
LLM_MODEL_READ=openai/gpt-4.1-mini
LLM_MODEL_VISION=openai/gpt-4.1-mini
LLM_MODEL_EMBED=openai/text-embedding-3-small
# Liara's ACCOUNT token (console → API), read-only use for the credit and
# usage lines on the AI card. It can also delete apps and databases, so:
# short expiry, rotated, GitHub-managed, never pasted anywhere.
LIARA_API_TOKEN=
