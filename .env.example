# =================================
# SorinFlow Divar Scraper Configuration
# =================================

# Environment
ENVIRONMENT=production

# Server Configuration
SERVER_IP=171.22.182.91
DOMAIN=scc.sorinflow.com
DOMAIN_DNS_ONLY=sc.sorinflow.com

# Database Configuration
POSTGRES_USER=sorinflow
POSTGRES_PASSWORD=sorinflow_secret_2024
POSTGRES_DB=divar_scraper
DATABASE_URL=postgresql+asyncpg://sorinflow:sorinflow_secret_2024@db:5432/divar_scraper

# Redis Configuration
REDIS_PASSWORD=redis_secret_2024
REDIS_URL=redis://:redis_secret_2024@redis:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-with-random-string
API_KEY=change-this-to-a-strong-random-api-key

# Scraper Configuration
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=60000
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5

# Proxy Configuration (Optional)
PROXY_ENABLED=false
PROXY_LIST=45.83.181.214:57623,146.19.143.69:11599

# Phone Number for Divar Login
DIVAR_PHONE_NUMBER=09058432452

# SMS — Kavenegar (https://kavenegar.com)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# SMS — Melipayamak (https://melipayamak.com)
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=

# Timezone
TZ=Asia/Tehran

# ── Public portal (visitor sign-up) ───────────────────────────────────────────
# Ships OFF. While false, /portal redirects to the dashboard and every
# /api/public/auth/* endpoint answers 404 — the live panel is untouched.
# Turn this on only once an Iranian SMS panel is provisioned below, otherwise
# users register and never receive their code.
PUBLIC_AUTH_ENABLED=false

# Which provider carries the login/registration code: kavenegar | melipayamak
AUTH_SMS_PROVIDER=kavenegar

# Verification code behaviour
AUTH_CODE_LENGTH=5
AUTH_CODE_TTL_SECONDS=180
AUTH_CODE_RESEND_COOLDOWN=90
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_MAX_SENDS_PER_HOUR=5
# Failed password attempts per identifier per 15 minutes before lockout
AUTH_LOGIN_MAX_ATTEMPTS=10

# ── Root account (the developer's own access) ─────────────────────────────────
# Seeded on boot and never creatable from the panel. Leave ROOT_PASSWORD empty
# to skip seeding entirely. Once the account exists this value is ignored, so
# putting it back cannot silently reset a rotated password.
ROOT_USERNAME=root
ROOT_PASSWORD=
ROOT_EMAIL=
